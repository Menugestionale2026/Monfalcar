# Copia questo file in ".env.local" e compila il valore (vedi README, punto 3.3).
# Senza questo valore il sito parte in MODALITA' DEMO con dati di esempio (nessun salvataggio reale).
# E' l'indirizzo dell'app web Google Apps Script: finisce con /exec
VITE_API_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxx/exec

# Percorso base del sito: "/" con dominio personalizzato, "/nome-repo/" su utente.github.io/nome-repo
VITE_BASE=/
